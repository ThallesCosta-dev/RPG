# Copie para .env e preencha. O .env nunca vai para o git.
GEMINI_API_KEY=
MODELO_PLANO=gemini-3.5-flash-lite
MODELO_NARRACAO=gemini-3.8-flash
# Nível de "pensamento" dos modelos Gemini 3.x na narração: low = resposta mais rápida. Vazio = padrão do modelo.
GEMINI_THINKING_LEVEL=low

# Limites do free tier (confira no console do AI Studio) — por modelo, por minuto / por dia
COTA_RPM=10
COTA_RPD=250
COTA_LIMIAR_ECONOMICO=0.7

# LLM local (endpoint OpenAI-compatível do llama.cpp / Ollama). Vazio = desligado.
LLM_LOCAL_URL=http://localhost:11434/v1
LLM_LOCAL_MODELO=gemma3:12b          # qualquer modelo listado em `ollama list` (ex.: qwen2.5:7b)

# Chave para assinar tokens de convite/sessão (gere com: python -c "import secrets;print(secrets.token_hex(32))")
CHAVE_TOKENS=troque-esta-chave

# Timers (segundos)
TIMEOUT_COMBATE=90
TIMEOUT_EXPLORACAO=180

# TTS: kokoro | piper | nenhum (auto = tenta kokoro, depois piper, depois nenhum)
TTS_MOTOR=auto

# ComfyUI headless para battlemaps. Vazio = só o mapa estilizado do cliente.
COMFYUI_URL=

# Caminhos
DIR_CARTUCHOS=cartuchos
DIR_DADOS=data
