# Copie para .env e preencha. O .env nunca vai para o git.
GEMINI_API_KEY=
MODELO_PLANO=gemini-3.5-flash-lite
MODELO_NARRACAO=gemini-3.5-flash-lite   # gemini-3.8-flash narra melhor, mas leva 3–13 s; o lite responde em 1–2 s
# Nível de "pensamento" dos modelos Gemini 3.x na narração: low = resposta mais rápida. Vazio = padrão do modelo.
GEMINI_THINKING_LEVEL=low

# Estimativa dos limites do free tier (só informativa: acima disso a IA entra no modo econômico; quem bloqueia é o 429 real da API)
COTA_RPM=10
COTA_RPD=1000
COTA_LIMIAR_ECONOMICO=0.7

# LLM local (endpoint OpenAI-compatível do llama.cpp / Ollama). Vazio = desligado.
LLM_LOCAL_URL=http://localhost:11434/v1
LLM_LOCAL_MODELO=gemma3:12b          # qualquer modelo listado em `ollama list` (ex.: qwen2.5:7b)

# Chave para assinar tokens de convite/sessão (gere com: python -c "import secrets;print(secrets.token_hex(32))")
CHAVE_TOKENS=troque-esta-chave

# Timers (segundos)
TIMEOUT_COMBATE=90
TIMEOUT_EXPLORACAO=180

# TTS: voicestudio | edge | kokoro | piper | nenhum (auto = o primeiro disponível nessa ordem)
TTS_MOTOR=auto
# VoiceStudio (app local, backend em :3900). Vozes = perfis criados no app; VOICESTUDIO_MODELO = engine (ex.: voicestudio)
VOICESTUDIO_URL=http://127.0.0.1:3900
VOICESTUDIO_MODELO=omnivoice
VOICESTUDIO_IDIOMA=pt
VOICESTUDIO_VOZ_PADRAO=default
VOICESTUDIO_NUM_STEP=16        # passos de inferência: 12 mais rápido, 32 mais qualidade
OMNIVOICE_API_KEY=

# ComfyUI headless para battlemaps. Vazio = só o mapa estilizado do cliente.
COMFYUI_URL=

# Caminhos
DIR_CARTUCHOS=cartuchos
DIR_DADOS=data
